{
  "name": "document-engine",
  "version": "0.0.0",
  "description": "Markdown parser and renderer that outputs HTML with a host-provided design theme",
  "license": "MIT",
  "author": "choi woo-nyong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woonyong-choi/document-engine.git"
  },
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./parser": "./parser/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "parser/",
    "renderer/",
    "theme/"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "lint": "prettier --check . && eslint --max-warnings 0 .",
    "check": "npm run lint && npm run test"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "1.1.2",
    "highlight.js": "11.12.0",
    "katex": "0.19.0",
    "markdown-it": "15.0.2",
    "markdown-it-deflist": "4.0.0",
    "markdown-it-footnote": "4.0.0",
    "shiki": "4.5.0",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@woonyong-choi/design-tokens": "^0.2.0",
    "diagramplay": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "diagramplay": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@woonyong-choi/design-tokens": "github:woonyong-choi/design-tokens#5fc5fec166898e17eea52434891bf585ed980257",
    "eslint": "10.12.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "diagramplay": "github:woonyong-choi/diagramplay#4850c23dae6cad989b29b6af691d5233bc9afd66"
  },
  "overrides": {
    "katex": "0.19.0"
  }
}
